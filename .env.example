# MongoDB Atlas connection string.
# Atlas → Cluster → Connect → Drivers. URL-encode a password containing @ : / ? # [ ] or %.
# Define this in exactly ONE file: neither Next nor dotenv overwrites an
# already-set variable, so an empty declaration elsewhere would shadow it.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database inside the cluster. Set explicitly because Atlas's connection string
# has no database path segment and Mongoose falls back to "test" without it.
MONGODB_DB="powerball"

# Session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Canonical app URL. Leave UNSET in development — Auth.js infers the origin from
# the request, so redirects stay correct whatever port `next dev` binds to.
# Set it only in production, to the real public origin.
# AUTH_URL="https://your-app.example.com"

# Sign-in tracing. Leave unset normally — the login path reports every failure
# identically by design, so these are the only way to tell a wrong password from
# an unreachable database. Server logs go to Vercel → Logs → Functions;
# NEXT_PUBLIC_ is inlined into the client bundle and needs a redeploy to change.
# Turn both off once the problem is found.
# AUTH_DEBUG="1"
# NEXT_PUBLIC_AUTH_DEBUG="1"

# Credentials used by `npm run seed:admin` to create the first account.
# LOCAL ONLY — read by scripts/seed-admin.ts, never by the app. Do not set these
# in Vercel; nothing there reads them.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"
